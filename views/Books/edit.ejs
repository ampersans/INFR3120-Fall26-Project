<div class="container">
    <div class="row">
        <div class="offset-md-3 col-md-6">
            <h1> Edit Book in Database</h1>
            <form class="form" method="post">
                <div class="form-group">
                    <label for="nameTextField">Title</label>
                    <input type="text" class="form-control" id="nameTextField"
                    placeholder="Enter title of book"
                    name="title"
                    value="<%= Book.title %>"
                    required>
                </div>
                <br>
                <div class="form-group">
                    <label for="authorTextField">Author</label>
                    <input type="text" class="form-control" id="authorTextField"
                    placeholder="Enter author of book"
                    name="author"
                    value="<%= Book.author %>"
                    required>
                </div>
                <br>
                <div class="form-group">
                    <label for="ISBNTextField">ISBN</label>
                    <input type="text" class="form-control" id="ISBNTextField"
                    placeholder="Enter ISBN of book"
                    name="isbn"
                    value="<%= Book.isbn %>"
                    >
                </div>
                <br>
                <div class="form-group">
                    <label for="genreTextField">Genre</label>
                    <input type="text" class="form-control" id="genreTextField"
                    placeholder="Enter genre of book"
                    name="genre"
                    value="<%= Book.genre %>"
                    >
                </div>
                <br>
                <div class="form-group">
                    <label for="copiesNumberField">Number of Copies</label>
                    <input type="number" class="form-control" id="copiesNumberField"
                    placeholder="Enter number of copies"
                    name="copies"
                    value="<%= Book.copies %>"
                    >
                </div>
                <br>
                <div class="form-group">
                    <label for="statusTextField">Status</label>
                    <input type="text" class="form-control" id="statusTextField"
                    placeholder="Enter status of book"
                    name="status"
                    value="<%= Book.status %>"
                    >
                </div>
                <br>
                <div class="form-group">
                    <label for="creationTextField">Creation Date</label>
                    <input type="text" class="form-control" id="creationTextField"
                    placeholder="Enter date of creation"
                    name="createdAt"
                    value="<%= Book.createdAt %>"
                    >
                </div>
                <br>
                <button type="submit">
                    Add data
                </button>
                <button>
                    <a href="/">Cancel</a>
                </button>
            </form>
        </div>
    </div>
</div>