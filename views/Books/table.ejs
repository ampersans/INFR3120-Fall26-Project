<!--Main content-->
<main class="container">
    <div class="row">
        <div class="table">
            <h1><%= title %></h1>
            <br>
            <table class="booksTable">
                <!--Header Row-->
                <tr>
                    <th class="titleHeader">Title</th>
                    <th class="authorHeader">Author</th>
                    <th class="ISBNHeader">ISBN</th>
                    <th class="genreHeader">Genre</th>
                    <th class="copiesHeader">Copies</th>
                    <th class="statusHeader">Status</th>
                    <th class="creationHeader">Created At</th>
                </tr>
                <!--Columns-->
                <% for(let count=0;count<Books.length;count++) { %>
                    <tr>-
                        <td class="titlerData"><%= Booklist[count].title %></td>
                        <td class="authorData"><%= Booklist[count].author %></td>
                        <td class="ISBNData"><%= Booklist[count].isbn %></td>
                        <td class="copiesData"><%= Booklist[count].copies %></td>
                        <td class="statusData"><%= Booklist[count].status %></td>
                        <td class="creationData"><%= Booklist[count].createdAt %></td>
                    </tr>
                <%} %>
            </table>
        </div>
    </div>
</main>